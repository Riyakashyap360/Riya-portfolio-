<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Riya Kashyap | AI with Riya</title>
<meta name="color-scheme" content="dark">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=Manrope:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#120e1a;--s:#1b1626;--s2:#241d32;--line:#322a46;--text:#f4f0fa;--mute:#aaa2bd;--pink:#ff4f93;--lav:#b9a3ff;
--head:"Bricolage Grotesque","Segoe UI",system-ui,sans-serif;--body:"Manrope","Segoe UI",system-ui,sans-serif;
color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{height:100%;scroll-behavior:smooth;scroll-padding-top:calc(env(safe-area-inset-top,0px) + 70px)}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font:400 16px/1.65 var(--body);-webkit-font-smoothing:antialiased;overflow-x:hidden}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:30}
a{color:inherit}
:focus-visible{outline:2px solid var(--lav);outline-offset:3px;border-radius:8px}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
h1,h2,h3{font-family:var(--head);margin:0;line-height:1.05;letter-spacing:-.02em}
.nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:rgba(18,14,26,.85);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:62px;gap:12px}
.logo{font:800 18px var(--head);text-decoration:none}.logo b{color:var(--pink)}
.links{display:none;gap:26px;font-size:14px;color:var(--mute)}.links a{text-decoration:none}.links a:hover{color:var(--text)}
@media(min-width:760px){.links{display:flex}}
.icons{display:flex;gap:10px}
.ic{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--line);border-radius:50%;background:var(--s);transition:border-color .2s}
.ic:hover{border-color:var(--pink)}.ic svg{width:19px;height:19px;fill:currentColor}
.btn{display:inline-flex;align-items:center;gap:10px;min-height:50px;padding:0 24px;border-radius:999px;font:700 15px var(--body);text-decoration:none;border:1px solid var(--line);background:var(--s);color:var(--text);cursor:pointer;transition:border-color .2s,transform .15s}
.btn:hover{border-color:var(--pink)}.btn:active{transform:scale(.98)}
.btn.main{background:var(--pink);border-color:var(--pink);color:#1a0a12}
.btn svg{width:18px;height:18px;fill:currentColor}
.btns{display:flex;flex-wrap:wrap;gap:12px}

.hero{position:relative;padding:64px 0 40px}
.hero::before{content:"";position:absolute;inset:-80px -20% auto auto;width:560px;height:560px;background:radial-gradient(closest-side,rgba(255,79,147,.22),transparent);pointer-events:none}
.hero .wrap{position:relative;display:grid;gap:44px;align-items:center}
@media(min-width:860px){.hero .wrap{grid-template-columns:1.25fr .75fr}}
.hello{color:var(--mute);margin:0 0 14px;font-size:17px}
.hero h1{font-size:clamp(52px,14vw,112px);font-weight:800}
.rot{margin:22px 0 0;font:600 clamp(22px,5.2vw,32px)/1.25 var(--head);color:var(--lav);min-height:2.5em}
.rot span{color:var(--text);display:inline-block;transition:opacity .35s,transform .35s}.rot span.out{opacity:0;transform:translateY(8px)}
.lede{max-width:33em;color:var(--mute);margin:14px 0 28px}
.phone{position:relative;width:100%;max-width:270px;margin:0 auto;aspect-ratio:9/16;border-radius:34px;border:7px solid #2b2340;background:#000;overflow:hidden;box-shadow:0 30px 70px -20px rgba(255,79,147,.35)}
.phone video,.phone img{width:100%;height:100%;object-fit:cover;display:block}

section{padding:64px 0}
.head{margin-bottom:30px}.head h2{font-size:clamp(32px,7.5vw,50px);font-weight:800}
.head p{margin:10px 0 0;color:var(--mute);max-width:34em}
.rows{border-top:1px solid var(--line)}
.row{display:grid;gap:6px;padding:24px 0;border-bottom:1px solid var(--line);align-items:start}
@media(min-width:760px){.row{grid-template-columns:300px 1fr auto;gap:34px}}
.row h3{font-size:23px}.row p{margin:0;color:var(--mute);max-width:36em}
.row a.see{color:var(--pink);font-weight:700;text-decoration:none;font-size:15px}

.band{background:var(--s);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.reel{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;margin:0 -20px;padding:4px 20px 14px;scrollbar-width:none}
.reel::-webkit-scrollbar{display:none}
.item{flex:none;width:min(62vw,250px);scroll-snap-align:start}
.item .phone{max-width:none}
.item h3{font-size:19px;margin:14px 0 4px}.item p{margin:0;color:var(--mute);font-size:14px;line-height:1.5}
.split{display:grid;gap:34px;align-items:center}
@media(min-width:860px){.split{grid-template-columns:1fr 1fr}.split.rev .media{order:2}}
.split p{color:var(--mute);margin:0 0 14px;max-width:34em}
.list{margin:0 0 22px;padding:0;list-style:none}
.list li{padding:10px 0 10px 24px;position:relative;border-bottom:1px solid var(--line)}
.list li::before{content:"";position:absolute;left:0;top:19px;width:9px;height:9px;border-radius:50%;background:var(--pink)}
.deck{width:min(100%,230px);height:440px;margin:0 auto;border:1px solid var(--line);border-radius:18px;overflow-y:auto;background:#f1ede2;box-shadow:0 24px 60px -24px rgba(185,163,255,.4)}
.deck img{width:100%;display:block}
.slides .s{flex:none;width:min(86vw,560px);scroll-snap-align:center}.slides img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:14px;border:1px solid var(--line);display:block;background:#f1ede2}.infog img{width:100%;max-width:300px;border-radius:18px;border:1px solid var(--line);display:block;margin:0 auto}
.cap{text-align:center;color:var(--mute);font-size:13px;margin-top:12px}
.shots .item{width:min(58vw,226px)}
.shots .frame{height:410px;border-radius:22px;border:6px solid #2b2340;overflow:hidden;background:#fff}
.shots .frame img{width:100%;height:100%;object-fit:cover;object-position:top;display:block}
.shots h3{font-size:17px}

.contact{background:var(--s);border:1px solid var(--line);border-radius:30px;padding:48px 24px;text-align:center}
.contact h2{font-size:clamp(32px,8vw,58px);font-weight:800;max-width:11em;margin:0 auto 14px}
.contact p{color:var(--mute);max-width:32em;margin:0 auto 26px}.contact .btns{justify-content:center}
footer{padding:26px 0 44px;color:var(--mute);font-size:14px;text-align:center}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}

.eui{font-family:var(--body)}
#etools{position:fixed;right:14px;bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:50;display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end;max-width:calc(100% - 28px)}
#etools button,.rep{min-height:44px;padding:0 16px;border-radius:999px;border:1px solid var(--pink);background:var(--bg);color:var(--text);font:700 14px var(--body);cursor:pointer}
#etools .go{background:var(--pink);color:#1a0a12}
#emsg{background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:6px 12px;font-size:13px}
.rep{position:absolute;left:8px;top:8px;z-index:5;min-height:38px;font-size:13px}
.editing [contenteditable]{outline:1px dashed var(--lav);outline-offset:3px;cursor:text}
</style>
</head>
